{
  "manifest_version": 3,
  "name": "NIRIKSHAK Link Guard",
  "version": "1.0.0",
  "description": "Checks external links against the NIRIKSHAK Cyber Crime Cell server before opening.",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NIRIKSHAK Link Guard"
  }
}
